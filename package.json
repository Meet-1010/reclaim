{
  "name": "reclaim-hw",
  "version": "0.1.1",
  "description": "Reclaim your hardware — one safe, emulator-first CLI to de-bloat, de-cloud and unlock devices you own. Starting with Android TV.",
  "type": "module",
  "bin": {
    "reclaim": "bin/reclaim.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/reclaim.js",
    "emu": "node bin/reclaim.js emulator start",
    "demo": "node bin/reclaim.js run androidtv/debloat --dry-run",
    "test": "node bin/reclaim.js validate",
    "prepublishOnly": "node bin/reclaim.js validate"
  },
  "files": [
    "bin",
    "src",
    "recipes",
    "profiles",
    "catalog",
    "lists"
  ],
  "keywords": [
    "android-tv",
    "debloat",
    "adb",
    "privacy",
    "modding",
    "homebrew",
    "right-to-repair",
    "cli"
  ],
  "author": "Meet Chauhan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet-1010/reclaim.git"
  },
  "bugs": {
    "url": "https://github.com/Meet-1010/reclaim/issues"
  },
  "homepage": "https://github.com/Meet-1010/reclaim#readme"
}
